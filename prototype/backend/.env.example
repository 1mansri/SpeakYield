SARVAM_API_KEY=

# Demo safety net: when 1, a failed/unconfigured Sarvam call returns a canned response
# instead of erroring, so a bad venue network can't dead-end a live demo. Leave unset for
# development and testing — it must never mask a real STT/LLM failure. See docs/DEMO_SCRIPT.md.
VOICE_FALLBACK=your-sarvam-api-key
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_CHAT_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_TTS_MODEL=bulbul:v3

# Comma-separated allowed browser origins for CORS. Local dev default is http://localhost:3000.
# In prod set this to the frontend's public URL, e.g. https://speakyield.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000